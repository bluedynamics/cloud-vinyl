
sub vcl_backend_response {
    # Prevent caching of zero-TTL objects; use uncacheable flag instead
    if (beresp.ttl <= 0s && beresp.http.Cache-Control !~ "max-age") {
        set beresp.ttl = 120s;
        set beresp.uncacheable = true;
    }

    # Ensure a grace period for stale-while-revalidate
    if (beresp.grace < 24h) {
        set beresp.grace = 24h;
    }
{{- if or .HasXkey .HasBAN }}

    # Copy URL and Host for BAN lurker friendliness (ban-lurker cannot access req.*)
    set beresp.http.x-url = bereq.url;
    set beresp.http.x-host = bereq.http.host;
{{- end }}
{{- if .HasESI }}

    # ESI processing for backends that declare it (Surrogate-Control per
    # W3C ESI 1.0). do_esi is meaningful on its own; the varnishd param
    # feature=+esi_disable_xml_check only matters when a response body
    # doesn't start with '<' (otherwise varnishd logs ESI_xmlerror and
    # serves the body unparsed).
    if (beresp.http.Surrogate-Control ~ "ESI/1.0") {
        set beresp.do_esi = true;
    }
{{- end }}
{{ if .Spec.VCL.Snippets.VCLBackendResponse }}{{ if .HasCluster }}
    # Cluster mode: run the snippet on the owner hop only (#150). On the
    # relay hop it would rework the owner's response a second time.
    # Only the relay forwards X-Vinyl-Shard.
    if (!bereq.http.X-Vinyl-Shard) {
{{- end }}
    # --- custom vcl_backend_response snippet ---
    {{ .Spec.VCL.Snippets.VCLBackendResponse }}
    # --- end custom vcl_backend_response snippet ---
{{- if .HasCluster }}
    }
{{- end }}
{{ end }}
    return(deliver);
}
