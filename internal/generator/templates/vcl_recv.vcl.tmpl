
sub vcl_recv {
    # Security: strip Proxy header to prevent SSRF (httpoxy CVE-2016-5385)
    unset req.http.proxy;

    # Normalize Host header: lowercase and strip port
    set req.http.Host = std.tolower(regsub(req.http.Host, ":[0-9]+$", ""));

    # Sort query string for better cache hit ratio
    set req.url = std.querysort(req.url);

    # PURGE handling
    if (req.method == "PURGE") {
        if (!client.ip ~ vinyl_purge_allowed) {
            return(synth(403, "Forbidden"));
        }
{{- if .HasXkey }}
        if (req.http.X-Xkey-Purge) {
            set req.http.n-gone = xkey.purge(req.http.X-Xkey-Purge);
            return(synth(200, "Purged " + req.http.n-gone + " objects"));
        }
        if (req.http.X-Xkey-Softpurge) {
            set req.http.n-gone = xkey.softpurge(req.http.X-Xkey-Softpurge);
            return(synth(200, "Softpurged " + req.http.n-gone + " objects"));
        }
{{- end }}
        # vmod_purge's soft/hard purge functions are restricted to
        # vcl_hit/vcl_miss (see those subs), so hash the request through
        # rather than purging directly here, which would always be hard.
        return(hash);
    }
{{- if .HasBAN }}

    # BAN handling — std.ban() preferred over deprecated ban() (Varnish >= 6.6).
    # std.ban() returns true on success, false on malformed expression;
    # std.ban_error() returns the last compile error for this session.
    if (req.method == "BAN") {
        if (!client.ip ~ vinyl_ban_allowed) {
            return(synth(403, "Forbidden"));
        }
        if (!req.http.X-Vinyl-Ban) {
            return(synth(400, "Missing X-Vinyl-Ban header"));
        }
        if (!std.ban(req.http.X-Vinyl-Ban)) {
            return(synth(400, "Invalid ban expression: " + std.ban_error()));
        }
        return(synth(200, "Banned"));
    }
{{- end }}
{{- if .HasCluster }}

    # Cluster routing. MUST run after PURGE/BAN handling above, never before
    # (#93). PURGE and BAN are control commands addressed to the specific pod
    # that receives them, authorized by checking the real client.ip against
    # vinyl_purge_allowed / vinyl_ban_allowed. This block's `return(pass)`
    # relays every method it sees to a peer; if it ran first, an operator's
    # PURGE/BAN would be relayed to a peer before that ACL check ran, and the
    # peer would see client.ip as the relaying Varnish pod instead of the
    # operator and reject it with 403. Do not move this block back above
    # PURGE/BAN handling.
    #
    # Strip spoofed X-Vinyl-Shard from untrusted clients
    if (req.http.X-Vinyl-Shard && !(client.ip ~ vinyl_cluster_peers)) {
        unset req.http.X-Vinyl-Shard;
    }
    # Route to responsible peer; if already routed, proceed to cache lookup
    if (!req.http.X-Vinyl-Shard) {
        set req.http.X-Vinyl-Shard = "1";
        set req.backend_hint = {{ .DirectorName }}.backend(by={{ .ClusterShardBy }}{{ if .ClusterShardHealthy }}, healthy={{ .ClusterShardHealthy }}{{ end }});
        return(pass);
    }
    unset req.http.X-Vinyl-Shard;
{{- end }}
{{- if .HasProxyProtocol }}

    # PROXY Protocol: extract real client IP from X-Forwarded-For
    if (req.http.X-Forwarded-For) {
        set req.http.X-Real-IP = regsub(req.http.X-Forwarded-For, ",.*$", "");
    }
{{- end }}

    # Only handle GET and HEAD for caching (pass everything else)
    if (req.method != "GET" && req.method != "HEAD") {
        return(pass);
    }
{{ if .Spec.VCL.Snippets.VCLRecv }}
    # --- custom vcl_recv snippet ---
    {{ .Spec.VCL.Snippets.VCLRecv }}
    # --- end custom vcl_recv snippet ---
{{ end }}
    return(hash);
}
